{% extends 'base.html' %}

{% block content %}

<h1>Historique des paiements de {{ locataire.user.username }}</h1>

<table>
    <thead>
        <tr>
            <th>Bien</th>
            <th>Mois concerné</th>
            <th>Montant</th>
            <th>Date paiement</th>
            <th>Mode</th>
            <th>Statut</th>
        </tr>
    </thead>

    <tbody>
        {% for paiement in paiements %}
        <tr>
            <td>{{ paiement.contrat.bien.titre }}</td>
            <td>{{ paiement.mois_concerne }}</td>
            <td>{{ paiement.montant }} FCFA</td>
            <td>{{ paiement.date_paiement }}</td>
            <td>{{ paiement.get_mode_paiement_display }}</td>
            <td>{{ paiement.get_statut_display }}</td>
        </tr>
        {% empty %}
        <tr>
            <td colspan="6">Aucun paiement pour ce locataire.</td>
        </tr>
        {% endfor %}
    </tbody>
</table>

<a href="{% url 'properties:liste_locataires' %}" class="action-btn">Retour aux locataires</a>

{% endblock %}